NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ridwan-8-chars

# Data Paths (Host Machine)
# --------------------------
DATA_PATH=../data

# Optional Settings
# -----------------
LOG_LEVEL=INFO
BATCH_SIZE=100



# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (scripts on host machine):
#    - Use this .env file as-is
#    - Run: python scripts/load.py
#    - Connects to: bolt://localhost:7687
#
# 2. DOCKER CONTAINER (scripts inside data-loader service):
#    - Docker Compose already sets environment variables
#    - Uses service name: bolt://exp-neo4j:7687
#    - Run: docker-compose run data-loader python load.py
#
# 3. TESTING CONNECTION:
#    Local:  Neo4j Browser at http://localhost:7474
#    Docker: Same URL, containers use internal network
#
# ============================================================================